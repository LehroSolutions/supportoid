{
  "name": "supportoid",
  "private": true,
  "version": "1.0.0",
  "description": "SupportOID hybrid root — Bun workspaces for frontend + convex-adapter; Python backend uses venv/pip",
  "license": "Apache-2.0",
  "author": "Lehro Solutions",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24",
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev:web": "bun run --filter supportoid-frontend dev",
    "build:web": "bun run --filter supportoid-frontend build",
    "build:adapter": "bun run --filter supportoid-convex-adapter build",
    "build:js": "bun run build:web && bun run build:adapter",
    "format:check": "bun run --filter supportoid-frontend format:check && bun run --filter supportoid-convex-adapter format:check",
    "lint": "bun run --filter supportoid-frontend lint",
    "verify:deps": "node scripts/verify-workspace-deps.mjs",
    "verify:js": "bun run verify:deps && bun run format:check && bun run lint && bun run build:js",
    "verify": "bun run verify:js && python -m pytest -q",
    "test:browser": "node scripts/browser-smoke.mjs",
    "install:js": "bun install",
    "package:manager": "bun --version",
    "docs:build": "node scripts/docs.mjs build",
    "docs:check": "node scripts/docs.mjs check"
  },
  "workspaces": [
    "frontend",
    "convex-adapter"
  ],
  "devDependencies": {
    "@playwright/test": "1.62.1"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "qs": "6.17.1",
    "source-map-js": "1.2.2",
    "zod": "4.6.7",
    "body-parser": "1.20.9",
    "postcss-selector-parser": "6.1.5"
  }
}
