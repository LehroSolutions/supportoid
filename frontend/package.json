{
  "name": "supportoid-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "package:manager": "bun --version",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,md,yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{json,md,yml,yaml}\"",
    "verify": "bun run format:check && bun run lint && bun run build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.8.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "framer-motion": "^10.16.0",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "tailwind-merge": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.16",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "postcss": "^8.4.32",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.2.2",
    "typescript-eslint": "8.70.0",
    "vite": "^8.0.10"
  },
  "license": "Apache-2.0",
  "author": "Lehro Solutions",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24",
    "bun": ">=1.3.14"
  }
}
